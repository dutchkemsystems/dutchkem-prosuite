{
    "name": "dutchkem-prosuite",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json && tsc --noEmit --skipLibCheck -p tsconfig.vite.json",
        "lint": "eslint src convex --ext .ts,.tsx",
        "lint:fix": "eslint src convex --ext .ts,.tsx --fix",
        "lint:src": "eslint src",
        "lint:convex": "eslint convex --ext .ts",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage",
        "clean": "rimraf dist .tanstack node_modules/.cache",
        "source-aws": "node scripts/source-aws-env.cjs",
        "deploy:with-aws": "npm run source-aws && npx convex deploy --typecheck=disable"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.84",
        "@auth/core": "^0.41.2",
        "@composio/core": "^0.11.0",
        "@convex-dev/agent": "^0.6.1",
        "@convex-dev/auth": "^0.0.94",
        "@convex-dev/react-query": "^0.1.0",
        "@openrouter/ai-sdk-provider": "^2.9.0",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@sentry/node": "^10.70.0",
        "@sentry/react": "^10.70.0",
        "@sentry/tracing": "^7.120.4",
        "@tanstack/react-query": "^5.100.13",
        "@tanstack/react-router": "^1.170.41",
        "@tanstack/react-router-with-query": "^1.130.17",
        "@types/dompurify": "^3.0.5",
        "ai": "^6.0.0",
        "chart.js": "^4.5.1",
        "convex": "^1.40.0",
        "convex-helpers": "0.1.103",
        "docx": "^9.7.1",
        "dompurify": "^3.4.11",
        "dotenv": "^16.4.7",
        "exceljs": "^4.4.0",
        "jspdf": "^4.2.1",
        "pptxgenjs": "^4.0.1",
        "react": "^19.2.6",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.2.6",
        "react-is": "^19.2.7",
        "recharts": "^3.8.1",
        "resend": "^6.12.3",
        "socket.io-client": "^4.2.0",
        "tailwind-merge": "^3.6.0",
        "three": "^0.184.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@convex-dev/eslint-plugin": "^1.2.2",
        "@edge-runtime/vm": "^5.0.0",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/eslint-config": "^0.4.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "concurrently": "^10.0.3",
        "convex-test": "^0.0.53",
        "eslint": "^9.39.4",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "5.4.5",
        "vite": "^8.0.14",
        "vitest": "^4.1.8"
    },
    "overrides": {},
    "lint-staged": {
        "*.{ts,tsx}": "eslint --fix",
        "*.{ts,tsx,json,md}": "prettier --write"
    }
}
