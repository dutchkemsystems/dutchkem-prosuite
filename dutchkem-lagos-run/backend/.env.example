# © 2026 Dutchkem Ventures. Proprietary and confidential.
# Server-only configuration for Dutchkem Ventures Presents: Lagos Run.
# Copy to backend/.env and fill in. NEVER commit real values.
#
# ⚠️  SECRET — must never reach the client, dist/, or git.
# ✅  PUBLIC — safe to expose, also baked into the client build.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public. Comma-separated exact origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://lagosrun.dutchkem.com

# ─── Secrets ⚠️  ────────────────────────────────────────────────────────────
# Signs player session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SIGNING_SECRET=replace-with-a-64-character-random-string
# Signs offline run results so the client cannot forge a score.
SCORE_SIGNING_SECRET=replace-with-a-64-character-random-string
# Signs purchase receipts handed back to the client.
RECEIPT_SIGNING_SECRET=replace-with-a-64-character-random-string

# Private. Admin alert webhook (Slack/Discord-compatible endpoint).
ADMIN_WEBHOOK_URL=

# ─── Kora Pay ⚠️  (server-side only) ────────────────────────────────────────
# Public key is safe in the client; secret/encryption keys are NOT.
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Kora signs webhooks with your SECRET KEY by default, so this may be
# left blank; set it only to accept a second key during rotation.
KORAPAY_WEBHOOK_SECRET=
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_REDIRECT_URL=https://lagosrun.dutchkem.com/?kora_return=1
KORA_WEBHOOK_URL=https://api.lagosrun.dutchkem.com/api/purchases/kora/webhook

# ─── Store receipts ⚠️  (server-side only) ──────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.dutchkem.lagosrun
# Full service-account JSON on one line. SECRET.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# SECRET.
APPLE_SHARED_SECRET=
APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APPLE_SANDBOX_URL=https://sandbox.itunes.apple.com/verifyReceipt

# ─── Anti-cheat / economy ───────────────────────────────────────────────────
MAX_REWARDED_ADS_PER_DAY=5
REWARD_CONSOLATION_COINS=50
MAX_SCORE_PER_RUN=500000
MAX_COINS_PER_DAY=100000
MIN_HUMAN_REACTION_MS=150

# ─── Storage ────────────────────────────────────────────────────────────────
DB_PATH=./data/lagosrun.db

# ─── AdMob server-side verification ─────────────────────────────────────────
ADMOB_SSV_PUBLIC_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_KEY_CACHE_TTL_MS=21600000
